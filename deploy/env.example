IMAGE_NAME=blend-CHANGEME:v0.1
COMPOSE_PROJECT_NAME=blend-CHANGEME

# uid:gid owning DATASETS_DIR / RUNS_DIR on the host (`id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000

# The pg stack does not read this file: export the same values when starting it,
# and keep config.ini [Database] host = PG_CONTAINER.
# BLEND_NET=blend-net
# PG_CONTAINER=blend-pg

DATASETS_DIR=/abs/path/datasets
RUNS_DIR=/abs/path/runs
CONFIG_FILE=/abs/path/config.ini
FASTTEXT_BIN=/abs/path/cc.en.300.bin
# Must contain tokenizers/punkt (and punkt_tab).
NLTK_DATA_DIR=/abs/path/nltk_data

# Optional caps, applied on the next run without a rebuild.
# BLEND_CPUS=0                                  # 0 = no cap
# BLEND_MEM_LIMIT=150g                          # hard RSS cap, no swap
# BLEND_DUCKDB_THREADS=                         # overrides [Database] duckdb_threads
# BLEND_DUCKDB_MEMORY_LIMIT=                    # overrides [Database] duckdb_memory_limit
# BLEND_PG_MAINTENANCE_WORK_MEM=                # pgvector index-build memory
# BLEND_PG_MAX_PARALLEL_MAINTENANCE_WORKERS=    # pgvector parallel index build
